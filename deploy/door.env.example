# /etc/prax/door.env — read by prax-door.service. Root-readable only:
#   install -m 0600 -o root -g root door.env /etc/prax/door.env
#
# The address the board has on your private network (the LAN, a VPN;
# Tailscale's 100.x.y.z is one example). Never a public one: the door
# speaks plain HTTP and trusts the network it is on.
PRAX_BIND=10.0.0.12

# The bearer token every client sends (the worker, the browser extension,
# Claude Code's MCP proxy, the prax command with --token).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PRAX_TOKEN=replace-me

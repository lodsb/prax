+# the focus of a conversation (``focus_entities``, ``_focus_vote``)
+FOCUS_WORDS = 4  # the longest run of the question's words looked up as a name
+FOCUS_ENTITIES = 2  # things a question is taken to be about
+FOCUS_MAX_DOCS = 300  # a name more documents state is a field, not a focus
+FOCUS_WORD_DOCS = 100  # a lone word more document fields hold is generic
+HOP_MAX_DOCS = 50  # and a neighbour stated that widely says nothing of it
+HOP_MAX = 200  # neighbours looked at
+FOCUS_OWN = 2  # a fact about the focus counts this many neighbours' facts
+
+
+def focus_entities(con: sqlite3.Connection, text: str) -> list[int]:
+    """The things a question is about: the graph's entities whose name or
+    label is a run of its words, the longest runs first, at most
+    ``FOCUS_ENTITIES``, one per name. A name stated in more than
+    ``FOCUS_MAX_DOCS`` documents is a field ("audio") and no focus. A lone
+    word is looked up only when at most ``FOCUS_WORD_DOCS`` document fields
+    hold it: "string", "method" and "work" are each a dozen small entities
+    of different types, and the text, not the graph, says they are
+    generic. What ``ask`` hands the next turn's search (``focus``)."""
+    words = _TOKEN.findall(text or "")
+    found: list[int] = []
+    names: set[str] = set()
+    taken = [False] * len(words)
+    for n in range(min(FOCUS_WORDS, len(words)), 0, -1):
+        for i in range(len(words) - n + 1):
+            if any(taken[i : i + n]):
+                continue
+            run = words[i : i + n]
+            if not any(len(w) > 2 and w.lower() not in STOPWORDS for w in run):
+                continue
+            if n == 1 and (
+                _docs(con, run[0], "documents_fts", cap=FOCUS_WORD_DOCS + 1)
+                > FOCUS_WORD_DOCS
+            ):
+                continue
+            for entity_id, name in con.execute(
+                "SELECT DISTINCT e.id, e.name FROM entity_labels l"
+                " JOIN entities e ON e.id = l.entity_id"
+                " WHERE l.label = ? COLLATE NOCASE AND e.canonical_id IS NULL",
+                (" ".join(run),),
+            ):
+                key = str(name).casefold()
+                if key in names:
+                    continue
+                docs = _stated_in(con, int(entity_id))
+                if 0 < docs <= FOCUS_MAX_DOCS:
+                    found.append(int(entity_id))
+                    names.add(key)
+                    taken[i : i + n] = [True] * n
+            if len(found) >= FOCUS_ENTITIES:
+                return found[:FOCUS_ENTITIES]
+    return found
+
+
+def _stated_in(con: sqlite3.Connection, entity_id: int) -> int:
+    """How many documents state a live fact about the entity."""
+    return int(
+        con.execute(
+            "SELECT count(DISTINCT source_doc) FROM edges WHERE valid_to IS NULL"
+            " AND (src = ? OR dst = ?)",
+            (entity_id, entity_id),
+        ).fetchone()[0]
+    )
+
+
+def _focus_documents(con: sqlite3.Connection, focus: list[int]) -> dict[int, int]:
+    """Each document's share of the focus's neighbourhood: ``FOCUS_OWN``
+    for a fact about a focus entity, one for each first-hop neighbour it
+    states a fact about (a neighbour stated in at most ``HOP_MAX_DOCS``
+    documents; the first ``HOP_MAX`` of them)."""
+    score: dict[int, int] = {}
+    hops: set[int] = set()
+    for f in focus:
+        for src, dst, doc in con.execute(
+            "SELECT src, dst, source_doc FROM edges WHERE valid_to IS NULL"
+            " AND (src = ? OR dst = ?)",
+            (f, f),
+        ):
+            if doc is not None:
+                score[int(doc)] = score.get(int(doc), 0) + FOCUS_OWN
+            other = int(dst) if int(src) == f else int(src)
+            if other not in focus:
+                hops.add(other)
+    for n in sorted(hops)[:HOP_MAX]:
+        docs = {
+            int(r[0])
+            for r in con.execute(
+                "SELECT DISTINCT source_doc FROM edges WHERE valid_to IS NULL"
+                " AND (src = ? OR dst = ?) AND source_doc IS NOT NULL",
+                (n, n),
+            )
+        }
+        if len(docs) > HOP_MAX_DOCS:
+            continue
+        for d in docs:
+            score[d] = score.get(d, 0) + 1
+    return score
+
+
+def _focus_vote(
+    con: sqlite3.Connection, fused: list[dict[str, Any]], focus: list[int] | None
+) -> list[dict[str, Any]]:
+    """The fused hits with the focus's vote: the candidates that share the
+    neighbourhood of the conversation's focus, ranked by how much of it,
+    each gain what a list ranking them would give (``knobs.FOCUS_WEIGHT``).
+    Nothing is filtered and nothing joins: only a candidate the lists
+    found is moved, so a hidden document never comes in this way."""
+    if not focus or not fused or not knobs.FOCUS_WEIGHT:
+        return fused
+    share = _focus_documents(con, focus)
+    touched = [h for h in fused if share.get(h["doc_id"])]
+    touched.sort(key=lambda h: -share[h["doc_id"]])  # stable: fused order on ties
+    for rank, h in enumerate(touched, 1):
+        h["score"] += knobs.FOCUS_WEIGHT / (RRF_K + rank)
+        h["focus_rank"] = rank
+    fused.sort(key=lambda h: -h["score"])
+    return fused
+
+
 PRIOR_DEPTH = 30  # the fused candidates looked at
 PRIOR_MIN = 3  # of them in one small domain; chance gives it 0.2
 PRIOR_SMALL = 0.2  # a domain holding less than this share of the documents
